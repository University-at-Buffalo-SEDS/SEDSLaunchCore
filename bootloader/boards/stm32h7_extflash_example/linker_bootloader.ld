/* Placeholder STM32H7 bootloader linker script. Fill memory sizes during board bring-up. */
MEMORY
{
  FLASH (rx) : ORIGIN = 0x08000000, LENGTH = 128K
  EXT_APP_A (rx) : ORIGIN = 0x90000000, LENGTH = 4096K
  EXT_APP_B (rx) : ORIGIN = 0x90400000, LENGTH = 4096K
  EXT_PERSIST (rw) : ORIGIN = 0x90E00000, LENGTH = 128K
  EXT_METADATA_0 (rw) : ORIGIN = 0x90F00000, LENGTH = 64K
  EXT_METADATA_1 (rw) : ORIGIN = 0x90F10000, LENGTH = 64K
  RAM (rwx)  : ORIGIN = 0x20000000, LENGTH = 512K
}
